# Porta HTTP do servidor (cliente compilado + Socket.IO na mesma porta)
PORT=3099
# Interface de escuta. 0.0.0.0 deixa o jogo acessível pela rede local.
HOST=0.0.0.0
# Origens extras permitidas para o Socket.IO, separadas por vírgula.
# Na rede local não é preciso preencher: a mesma origem já é aceita.
ALLOWED_ORIGINS=
# Prazo de reconexão em milissegundos (padrão em shared/src/constants/config.ts)
RECONEXAO_MS=
